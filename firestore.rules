rules_version = '2';

// Reglas redactadas a partir de un mapeo exacto de los accesos reales del
// código (auditoría 2026-07-18). Reemplazan `allow read, write: if true`
// que estaba activo en producción — hueco crítico: cualquiera podía leer y
// escribir cualquier documento sin autenticarse.
//
// Limitaciones conocidas y aceptadas (mejoran muchísimo sobre el estado
// anterior, pero no son perfectas — requieren cambios de código para
// cerrarse del todo):
// - `solicitudes` en estado 'buscando': cualquier usuario con rol=='conductor'
//   puede escribir el documento completo, no solo los campos de
//   conductor/contraoferta, porque el código no separa esas escrituras por
//   campo (InicioConductorViewModel.aceptarSolicitud/enviarContraoferta).
// - `administradores`: lectura abierta a cualquier autenticado porque
//   AdminFcmService.sendToAllAdmins (llamado por clientes y conductores)
//   lee toda la colección sin filtro para juntar tokens FCM. Expone
//   nombre/teléfono/gremio de admins a cualquier usuario logueado. Fix
//   correcto a mediano plazo: mover ese envío a una Cloud Function.
// - `usuarios` con rol=='conductor': lectura abierta a cualquier admin
//   autenticado (no solo el admin dueño del gremio) porque
//   gestion_conductores_viewmodel.dart lista TODOS los conductores sin
//   filtrar por adminId en la query — el aislamiento por gremio hoy es
//   solo client-side.
//
// Antes de desplegar a producción: probar con el emulador de Firestore
// (firebase emulators:start) contra los flujos reales de la app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminRole() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    // Acepta las DOS marcas de conductor que reconoce el código, no solo
    // `rol`: `initial_screen_resolver.dart:148-158` cae a `tipoUsuario` como
    // fallback cuando `rol` no resuelve, y `streamConductoresDisponibles()`
    // consulta `usuarios where tipoUsuario == 'conductor'`. Hay conductores
    // en producción marcados solo con el campo legacy; mirando únicamente
    // `rol`, la app los mandaba a su home y ahí la lista de solicitudes
    // quedaba vacía con `permission-denied` (visto en dispositivo real).
    function isConductorRole() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '') == 'conductor' ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('tipoUsuario', '') == 'conductor');
    }

    // ---------------------------------------------------------------
    // solicitudes: doc autogenerado. cliente.id = dueño; conductor.id =
    // asignado (ausente hasta que alguien acepta). Un conductor necesita
    // poder LEER y ACTUALIZAR solicitudes en 'buscando' antes de ser suyas
    // (para poder verlas, aceptarlas o mandar contraoferta).
    // ---------------------------------------------------------------
    match /solicitudes/{solicitudId} {
      function isOwner() {
        return isSignedIn() && resource.data.cliente.id == request.auth.uid;
      }

      function isAssignedConductor() {
        return isSignedIn() &&
          resource.data.get('conductor', null) != null &&
          resource.data.conductor.id == request.auth.uid;
      }

      function isOpenForConductores() {
        return resource.data.estado in ['buscando', 'pending', 'pendiente'];
      }

      allow read: if isOwner() || isAssignedConductor() ||
        (isConductorRole() && isOpenForConductores());

      allow create: if isSignedIn() &&
        request.resource.data.cliente.id == request.auth.uid &&
        request.resource.data.estado == 'buscando';

      allow update: if isOwner() || isAssignedConductor() ||
        (isConductorRole() && isOpenForConductores());

      allow delete: if false;

      match /mensajes/{mensajeId} {
        function solicitudPadre() {
          return get(/databases/$(database)/documents/solicitudes/$(solicitudId)).data;
        }

        function esParticipante() {
          return isSignedIn() &&
            (solicitudPadre().cliente.id == request.auth.uid ||
              (solicitudPadre().get('conductor', null) != null &&
                solicitudPadre().conductor.id == request.auth.uid));
        }

        allow read: if esParticipante();
        allow create: if esParticipante() &&
          request.resource.data.senderId == request.auth.uid;

        // El mensaje es inmutable salvo por el acuse de lectura:
        // `ChatFirestoreDatasource.markMessageRead` hace
        // `update({'readBy.$uid': true})`. Con `allow update: if false` el
        // mensaje se enviaba y se leía bien, pero nunca se marcaba como leído
        // y el contador de no leídos no bajaba nunca (visto en dispositivo
        // real). Cada participante solo puede tocar SU propia clave dentro de
        // `readBy`: no puede editar el texto, ni el remitente, ni marcar como
        // leído en nombre del otro.
        allow update: if esParticipante() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.diff(resource.data.get('readBy', {}))
            .affectedKeys().hasOnly([request.auth.uid]);

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // usuarios: doc id = uid de Auth, compartido entre cliente y conductor
    // (campo `rol`). Conductores tienen `adminId` = uid del admin dueño del
    // gremio, que puede gestionarlos.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      // El admin lee CUALQUIER usuario, no solo conductores: `AdminHomeScreen`
      // consulta `usuarios` sin filtro y reparte el resultado en las pestañas
      // Conductores y Clientes. Con la restricción a `rol == 'conductor'`,
      // Firestore rechazaba la query entera —no la filtra, la niega— y el
      // panel quedaba vacío. Lo detectó `rules-tests/queries.test.js`.
      //
      // Implica que un admin ve nombre, teléfono y foto de los clientes; es
      // la función que el panel ya ofrece hoy.
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || isAdminRole());

      allow create: if isSignedIn() &&
        (request.auth.uid == uid || isAdminRole());

      // El propio usuario SÍ puede cambiar su `rol`: es un flujo real de la
      // app, no una escalada. "Modo conductor" / "Volver a ser cliente" en
      // `perfil.dart:331,370`, `InicioConductorView:1598` y el auto-registro
      // de `completar_registro_conductor_view.dart:171` escriben `rol` en el
      // doc propio. Prohibirlo dejaba al usuario en el home del conductor
      // (la navegación es fire-and-forget + caché local de `SessionHelper`)
      // con `rol: 'cliente'` en Firestore → `isConductorRole()` false → la
      // lista de solicitudes pendientes quedaba vacía para siempre.
      //
      // La guarda real es la MEMBRESÍA, no el rol: `aceptarSolicitud`
      // (`InicioConductorViewModel:481-484`) exige `membresia == 'activa'` y
      // `membresiaVence` en el futuro dentro de su transacción, y solo el
      // admin la otorga (`aprobarMembresiaConductor`). Un usuario que se
      // auto-marque conductor puede ver la lista, pero no tomar viajes.
      //
      // El rol propio queda acotado a ['cliente', 'conductor']: nadie más
      // escribe otro valor en `usuarios` (`guardarAdministrador` escribe en
      // la colección `administradores` y no tiene llamadores), y
      // `initial_screen_resolver.dart:137` enruta al panel de admin con
      // `rol == 'admin' || 'administrador'`, así que sin este límite un
      // usuario podría escribírselo y abrir el panel.
      //
      // Consecuencia aceptada: cualquier usuario puede auto-marcarse
      // conductor y leer las solicitudes en `buscando` (nombre, teléfono y
      // ubicación del cliente). La app ya lo permite por diseño — el botón
      // "Ser conductor" no requiere aprobación para cambiar el rol — así que
      // la regla no puede ser más estricta que el flujo sin romperlo.
      //
      // El admin puede modificar cualquier usuario, sin exigir que ya sea
      // conductor ni que le pertenezca por gremio. El modelo de gremios
      // (`adminId`) no está en uso: NINGÚN documento de `usuarios` en
      // producción tiene ese campo, y nada lo filtra por él. Además el flujo
      // real es aprobar la membresía de un usuario que TODAVÍA es
      // `rol: 'cliente'` con `solicitudConductor: true`, así que exigir
      // `rol == 'conductor'` bloqueaba justo la operación principal del panel
      // (`UserDataService.aprobarMembresiaConductor`).
      allow update: if isSignedIn() &&
        ((request.auth.uid == uid &&
            request.resource.data.get('rol', 'cliente') in ['cliente', 'conductor'] &&
            request.resource.data.get('membresia', '') ==
              resource.data.get('membresia', '') &&
            request.resource.data.get('membresiaVence', null) ==
              resource.data.get('membresiaVence', null)) ||
          isAdminRole());

      allow delete: if isAdminRole();

      // Direcciones favoritas del propio usuario.
      match /favoritos/{favoritoId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Espejo de `usuarios` para clientes (compatibilidad legacy, mismo uid).
    match /cliente/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Historial de ubicaciones buscadas/guardadas por el cliente.
    match /ubicaciones/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // conductores: colección casi sin uso (una sola query en todo el
    // código, para marcadores de taxis disponibles en el mapa del
    // cliente). Sin escrituras conocidas — se deniegan por defecto.
    // ---------------------------------------------------------------
    match /conductores/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Presencia en vivo del conductor conectado (para el mapa "sonar" del
    // cliente). Doc id = uid del conductor, self-managed.
    match /conductores_conectados/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // administradores: escritura solo del propio dueño. Lectura abierta a
    // cualquier usuario autenticado porque `AdminFcmService.sendToAllAdmins`
    // (llamado por clientes Y conductores, ver soporte_chat_service.dart,
    // completar_registro_conductor_view.dart, activacion_servicio_view.dart)
    // hace un `.get()` sin filtro sobre toda la colección para juntar
    // `fcmToken` de todos los admins.
    // ---------------------------------------------------------------
    // ESCALADA DE PRIVILEGIOS CERRADA: antes era
    // `allow write: if isSignedIn() && request.auth.uid == uid`, que permite
    // CREAR el documento propio. Como `isAdminRole()` se limita a comprobar
    // que exista `administradores/{uid}`, cualquier usuario autenticado podía
    // crearse el suyo y quedar como admin: acceso a todos los perfiles de
    // conductor, chats de soporte, reportes y alertas de pánico.
    //
    // Se permite solo ACTUALIZAR un documento que ya existe (lo necesita
    // `FcmService` para persistir el `fcmToken`, y solo escribe si el doc ya
    // existía). La creación queda fuera de la app a propósito: se hace desde
    // la consola o el backend. `UserDataService.guardarAdministrador` no
    // tiene llamadores, así que esto no rompe ningún flujo.
    match /administradores/{uid} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------
    // soporte_chats/{userId}: chat de soporte entre un usuario (cliente o
    // conductor) y cualquier admin. Doc id = uid del usuario.
    // ---------------------------------------------------------------
    match /soporte_chats/{userId} {
      allow read, write: if isSignedIn() &&
        (request.auth.uid == userId || isAdminRole());

      match /mensajes/{mensajeId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || isAdminRole());
        allow create: if isSignedIn() &&
          (request.auth.uid == userId || isAdminRole());
        allow update, delete: if false;
      }
    }

    // Reportes (problema con conductor/cliente). Solo el autor los crea con
    // su propio id; solo admins los leen/marcan como atendidos.
    match /reportes/{id} {
      allow read, update: if isAdminRole();
      allow create: if isSignedIn() &&
        (request.resource.data.get('clienteId', '') == request.auth.uid ||
          request.resource.data.get('conductorId', '') == request.auth.uid);
      allow delete: if false;
    }

    // Sugerencias de usuarios. Solo el autor las crea; solo admins las leen
    // y marcan como vistas.
    match /sugerencias/{id} {
      allow read, update: if isAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Alertas de pánico (botón SOS). Solo el autor las crea; solo admins
    // las leen y las marcan como atendidas.
    match /emergencias/{id} {
      allow read, update: if isAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
