rules_version = '2';

// Reglas redactadas a partir de un mapeo exacto de los accesos reales del
// código (auditoría 2026-07-18). Reemplazan `allow read, write: if true`
// que estaba activo en producción — hueco crítico: cualquiera podía leer y
// escribir cualquier documento sin autenticarse.
//
// Limitaciones conocidas y aceptadas (mejoran muchísimo sobre el estado
// anterior, pero no son perfectas — requieren cambios de código para
// cerrarse del todo):
// - `solicitudes` en estado 'buscando': cualquier usuario con rol=='conductor'
//   puede escribir el documento completo, no solo los campos de
//   conductor/contraoferta, porque el código no separa esas escrituras por
//   campo (InicioConductorViewModel.aceptarSolicitud/enviarContraoferta). Sí
//   se cerró la parte más grave: pasar a 'asignado' exige membresía activa
//   (`membresiaVigente()`) y, una vez el viaje está en un estado terminal,
//   solo se puede seguir escribiendo la calificación (`soloCambiaCalificacion()`).
// - `usuarios` con `tipoUsuario`/`rol` == 'conductor': autoasignable por
//   diseño (botón "Ser conductor", sin aprobación) — cualquiera puede leer
//   las solicitudes en 'buscando'. No es un descuido de esta regla: es una
//   decisión de producto ya aceptada, y `tipoUsuario` no le agrega alcance a
//   `rol` (ambos dan exactamente el mismo `isConductorRole()`), así que
//   restringir uno sin el otro no cierra nada.
// - `usuarios` con rol=='conductor': lectura abierta a cualquier admin
//   autenticado (no solo el admin dueño del gremio) porque
//   gestion_conductores_viewmodel.dart lista TODOS los conductores sin
//   filtrar por adminId en la query — el aislamiento por gremio hoy es
//   solo client-side.
//
// Antes de desplegar a producción: probar con el emulador de Firestore
// (rules-tests/, `npm test`) contra los flujos reales de la app.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Decisión de diseño (reemplaza a la versión anterior, que exigía
    // `exists(administradores/{uid})`): el admin se determina por el MISMO
    // campo `usuarios/{uid}.rol` que decide cliente/conductor — sin una
    // colección aparte que pueda desalinearse de lo que el código realmente
    // usa para enrutar (`initial_screen_resolver.dart`, `home_screen.dart`).
    //
    // Hueco cerrado para que esto sea seguro: `usuarios/{uid}` permite
    // `create` propio sin restricción de `rol` (solo `update` la tenía) —
    // así que un usuario nuevo podía auto-declararse admin en su propio
    // registro. La regla de `create` de abajo ahora exige `rol in
    // ['cliente','conductor']` igual que `update`, así que la ÚNICA forma de
    // que un doc quede con `rol: 'admin'/'administrador'` es que lo escriba
    // un admin ya existente (bypass de `isAdminRole()` en el `update`) o que
    // se edite directo en Firestore console — nunca el propio usuario.
    // `.lower()`: `client_user_firestore_datasource.dart:resolveRole` (y
    // cada otro lector de rol en Dart) ya normaliza con `.toLowerCase()`
    // porque el valor real en producción no está garantizado en minúsculas
    // exactas (altas viejas, ediciones manuales en consola). Sin este
    // `.lower()` acá, una cuenta con `rol: 'Cliente'`/`'ADMIN'` pasaba el
    // enrutado de la app pero SIEMPRE se le negaba escribir su propio doc
    // (token FCM, ubicación) — confirmado en dispositivo real: `usuarios/
    // {uid}` en loop de `permission-denied` desde el arranque, sin ningún
    // error visible en la UI (auditoría de bugs).
    function isAdminRole() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '').lower() in ['admin', 'administrador'];
    }

    // Acepta las DOS marcas de conductor que reconoce el código, no solo
    // `rol`: `initial_screen_resolver.dart:148-158` cae a `tipoUsuario` como
    // fallback cuando `rol` no resuelve, y `streamConductoresDisponibles()`
    // consulta `usuarios where tipoUsuario == 'conductor'`. Hay conductores
    // en producción marcados solo con el campo legacy; mirando únicamente
    // `rol`, la app los mandaba a su home y ahí la lista de solicitudes
    // quedaba vacía con `permission-denied` (visto en dispositivo real).
    function isConductorRole() {
      return isSignedIn() &&
        (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '').lower() == 'conductor' ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('tipoUsuario', '').lower() == 'conductor');
    }

    // ---------------------------------------------------------------
    // solicitudes: doc autogenerado. cliente.id = dueño; conductor.id =
    // asignado (ausente hasta que alguien acepta). Un conductor necesita
    // poder LEER y ACTUALIZAR solicitudes en 'buscando' antes de ser suyas
    // (para poder verlas, aceptarlas o mandar contraoferta).
    // ---------------------------------------------------------------
    match /solicitudes/{solicitudId} {
      function isOwner() {
        return isSignedIn() && resource.data.cliente.id == request.auth.uid;
      }

      function isAssignedConductor() {
        return isSignedIn() &&
          resource.data.get('conductor', null) != null &&
          resource.data.conductor.id == request.auth.uid;
      }

      function isOpenForConductores() {
        return resource.data.estado in ['buscando', 'pending', 'pendiente'];
      }

      // Estados terminales: una vez el viaje llegó a uno de estos, la única
      // escritura que le queda al dueño es calificar (ver
      // `soloCambiaCalificacion()` abajo). Cierra el hueco de la auditoría de
      // seguridad: antes `allow update: if isOwner() || ...` no distinguía
      // estado, así que el pasajero podía bajar `tarifa.total` o reabrir
      // `estado` después de que el viaje ya había terminado o se había
      // cancelado. Coincide con `SolicitudEstado.isTerminal()` en Dart.
      function esEstadoTerminal(estado) {
        return estado in ['completado', 'cancelado', 'sin respuesta'];
      }

      // Único write que sigue vivo sobre un viaje ya terminado:
      // `ResumenViajeFirebaseService.guardarCalificacion` escribe estas 3
      // claves (+ el `updatedAt` que el resto de escrituras ya manda de
      // paso) sobre un doc en 'completado'. Nada de `tarifa`, `estado` ni
      // `conductor` puede colarse en ese mismo update.
      function soloCambiaCalificacion() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['calificacion', 'comentarioCalificacion', 'fechaCalificacion', 'updatedAt']);
      }

      // Verdadero solo en el instante en que el documento pasa a tener
      // conductor asignado por primera vez (buscando -> asignado). Cubre los
      // dos caminos que llegan a ese mismo cambio: el conductor aceptando
      // directo (`InicioConductorViewModel.aceptarSolicitud`,
      // `conductor.id == request.auth.uid`) y el cliente aceptando una
      // contraoferta (`BuscandoTaxiViewModel.aceptarContraofertaDeConductor`,
      // donde `conductor.id` es el conductor de la oferta, no quien escribe).
      function esNuevaAsignacion() {
        return resource.data.get('estado', '') != 'asignado' &&
          request.resource.data.get('estado', '') == 'asignado';
      }

      // Espejo, del lado del servidor, de la validación que
      // `InicioConductorViewModel.aceptarSolicitud` ya hace en su propia
      // transacción (auditoría de seguridad: esa transacción es 100%
      // cliente, y `aceptarContraofertaDeConductor` ni siquiera la repite).
      // Mismo criterio exacto que el código: `membresia == 'activa'` Y
      // (`membresiaVence` ausente/no-timestamp, o en el futuro) — un
      // conductor con `membresia: 'activa'` sin `membresiaVence` sigue
      // pasando, igual que en Dart, para no volver más estricta una regla
      // de negocio que no es parte de esta auditoría. `.lower()` en
      // `membresia` por el mismo motivo que `isAdminRole()`: el código Dart
      // ya compara con `.toLowerCase() == 'activa'`
      // (`InicioConductorViewModel:466-468`), señal de que el valor real no
      // está garantizado en minúsculas exactas.
      function membresiaVigente(uid) {
        let c = get(/databases/$(database)/documents/usuarios/$(uid)).data;
        let vence = c.get('membresiaVence', null);
        let vencida = vence is timestamp && vence < request.time;
        return c.get('membresia', '').lower() == 'activa' && !vencida;
      }

      allow read: if isOwner() || isAssignedConductor() ||
        (isConductorRole() && isOpenForConductores());

      allow create: if isSignedIn() &&
        request.resource.data.cliente.id == request.auth.uid &&
        request.resource.data.estado == 'buscando';

      // La propiedad del viaje (`cliente.id`) es inmutable en cualquier
      // update, esté o no terminal.
      allow update: if request.resource.data.cliente.id == resource.data.cliente.id &&
        (
          (esEstadoTerminal(resource.data.estado) &&
            isOwner() && soloCambiaCalificacion()) ||
          (!esEstadoTerminal(resource.data.estado) &&
            (isOwner() || isAssignedConductor() ||
              (isConductorRole() && isOpenForConductores())) &&
            (!esNuevaAsignacion() ||
              membresiaVigente(request.resource.data.conductor.id)))
        );

      allow delete: if false;

      match /mensajes/{mensajeId} {
        function solicitudPadre() {
          return get(/databases/$(database)/documents/solicitudes/$(solicitudId)).data;
        }

        function esParticipante() {
          return isSignedIn() &&
            (solicitudPadre().cliente.id == request.auth.uid ||
              (solicitudPadre().get('conductor', null) != null &&
                solicitudPadre().conductor.id == request.auth.uid));
        }

        allow read: if esParticipante();
        allow create: if esParticipante() &&
          request.resource.data.senderId == request.auth.uid;

        // El mensaje es inmutable salvo por el acuse de lectura:
        // `ChatFirestoreDatasource.markMessageRead` hace
        // `update({'readBy.$uid': true})`. Con `allow update: if false` el
        // mensaje se enviaba y se leía bien, pero nunca se marcaba como leído
        // y el contador de no leídos no bajaba nunca (visto en dispositivo
        // real). Cada participante solo puede tocar SU propia clave dentro de
        // `readBy`: no puede editar el texto, ni el remitente, ni marcar como
        // leído en nombre del otro.
        allow update: if esParticipante() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
          request.resource.data.readBy.diff(resource.data.get('readBy', {}))
            .affectedKeys().hasOnly([request.auth.uid]);

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // usuarios: doc id = uid de Auth, compartido entre cliente y conductor
    // (campo `rol`). Conductores tienen `adminId` = uid del admin dueño del
    // gremio, que puede gestionarlos.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      // El admin lee CUALQUIER usuario, no solo conductores: `AdminHomeScreen`
      // consulta `usuarios` sin filtro y reparte el resultado en las pestañas
      // Conductores y Clientes. Con la restricción a `rol == 'conductor'`,
      // Firestore rechazaba la query entera —no la filtra, la niega— y el
      // panel quedaba vacío. Lo detectó `rules-tests/queries.test.js`.
      //
      // Implica que un admin ve nombre, teléfono y foto de los clientes; es
      // la función que el panel ya ofrece hoy.
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || isAdminRole());

      // El propio usuario SÍ puede crear su doc con `rol` en
      // `['cliente','conductor']` (o ausente, default 'cliente') — igual
      // que el `update` de abajo. Sin esta restricción, un usuario nuevo
      // podía mandar `rol: 'administrador'` en su PRIMER `set` (el `create`
      // no tenía ningún filtro de campos) y autodeclararse admin apenas se
      // registraba, ya que `isAdminRole()` ahora lee este mismo campo — el
      // hueco que hay que cerrar para que ese diseño sea seguro.
      allow create: if isSignedIn() &&
        ((request.auth.uid == uid &&
            request.resource.data.get('rol', 'cliente').lower() in ['cliente', 'conductor']) ||
          isAdminRole());

      // El propio usuario SÍ puede cambiar su `rol`: es un flujo real de la
      // app, no una escalada. "Modo conductor" / "Volver a ser cliente" en
      // `perfil.dart:331,370`, `InicioConductorView:1598` y el auto-registro
      // de `completar_registro_conductor_view.dart:171` escriben `rol` en el
      // doc propio. Prohibirlo dejaba al usuario en el home del conductor
      // (la navegación es fire-and-forget + caché local de `SessionHelper`)
      // con `rol: 'cliente'` en Firestore → `isConductorRole()` false → la
      // lista de solicitudes pendientes quedaba vacía para siempre.
      //
      // La guarda real es la MEMBRESÍA, no el rol: `aceptarSolicitud`
      // (`InicioConductorViewModel:481-484`) exige `membresia == 'activa'` y
      // `membresiaVence` en el futuro dentro de su transacción, y solo el
      // admin la otorga (`aprobarMembresiaConductor`). Un usuario que se
      // auto-marque conductor puede ver la lista, pero no tomar viajes —
      // ESTO ya no depende solo de esa transacción del cliente:
      // `solicitudes/{id}.membresiaVigente()` (auditoría de seguridad)
      // repite el mismo chequeo del lado del servidor en la transición
      // buscando → asignado, así que tampoco se puede tomar un viaje
      // llamando directo al SDK sin pasar por la app.
      //
      // El rol propio queda acotado a ['cliente', 'conductor']: nadie más
      // escribe otro valor en `usuarios` (`guardarAdministrador` escribe en
      // la colección `administradores` y no tiene llamadores), y
      // `initial_screen_resolver.dart:137` enruta al panel de admin con
      // `rol == 'admin' || 'administrador'`, así que sin este límite un
      // usuario podría escribírselo y abrir el panel.
      //
      // Consecuencia aceptada: cualquier usuario puede auto-marcarse
      // conductor y leer las solicitudes en `buscando` (nombre, teléfono y
      // ubicación del cliente). La app ya lo permite por diseño — el botón
      // "Ser conductor" no requiere aprobación para cambiar el rol — así que
      // la regla no puede ser más estricta que el flujo sin romperlo.
      //
      // El admin puede modificar cualquier usuario, sin exigir que ya sea
      // conductor ni que le pertenezca por gremio. El modelo de gremios
      // (`adminId`) no está en uso: NINGÚN documento de `usuarios` en
      // producción tiene ese campo, y nada lo filtra por él. Además el flujo
      // real es aprobar la membresía de un usuario que TODAVÍA es
      // `rol: 'cliente'` con `solicitudConductor: true`, así que exigir
      // `rol == 'conductor'` bloqueaba justo la operación principal del panel
      // (`UserDataService.aprobarMembresiaConductor`).
      // `deshabilitado` sigue el mismo patrón que `membresia`/`membresiaVence`
      // arriba: el propio dueño no puede tocarlo, solo el admin
      // (`UserDataService.deshabilitarUsuario`, reemplaza al borrado duro
      // que había antes — ver ese método). Sin esta restricción, un usuario
      // deshabilitado podría reactivarse solo con cualquier escritura propia
      // normal (p.ej. `FcmService._persistToken`, que hace `set(merge:true)`
      // sobre su propio doc constantemente).
      // `.lower()`: mismo motivo que `isAdminRole()`/`isConductorRole()` más
      // arriba — sin esto, cualquier `set(merge:true)` sobre el doc propio
      // que no toque `rol` (guardar token FCM, ubicación) hereda el valor
      // YA EXISTENTE en `request.resource.data.rol` tal cual está guardado;
      // si esa cuenta tiene `rol` con una mayúscula distinta a
      // 'cliente'/'conductor' exactas, quedaba con TODO write propio
      // denegado en loop, para siempre, sin ningún error visible en la UI
      // (auditoría de bugs — visto en dispositivo real).
      allow update: if isSignedIn() &&
        ((request.auth.uid == uid &&
            request.resource.data.get('rol', 'cliente').lower() in ['cliente', 'conductor'] &&
            request.resource.data.get('membresia', '') ==
              resource.data.get('membresia', '') &&
            request.resource.data.get('membresiaVence', null) ==
              resource.data.get('membresiaVence', null) &&
            request.resource.data.get('deshabilitado', false) ==
              resource.data.get('deshabilitado', false)) ||
          isAdminRole());

      // El propio usuario puede eliminar su cuenta (`EliminarCuentaScreen`,
      // botón "Eliminar cuenta" en Configuración de la app, cliente y
      // conductor). Antes solo el admin podía borrar `usuarios/{uid}`, así
      // que ese flujo fallaba con permission-denied para todo el mundo — la
      // UI ya existía pero no tenía forma real de completarse.
      //
      // EXCEPTO si está deshabilitado: el `update` de arriba le impide
      // limpiarse el flag, pero borrar y volver a crear el doc saltaba esa
      // guarda entera — el doc nuevo nace sin `deshabilitado` y la cuenta
      // queda activa otra vez (verificado contra el emulador; el token de
      // Auth sigue vivo porque nada llama `admin.auth().disableUser()`).
      // Un usuario legítimo que quiere borrar su cuenta no está
      // deshabilitado, así que `EliminarCuentaScreen` no se ve afectada.
      // `resource == null` es el doc que YA no existe: borrarlo de nuevo es
      // un no-op, pero sin este caso la regla evaluaba `resource.data` sobre
      // null y denegaba. Pasa de verdad tras un borrado a medias (el doc se
      // fue, `user.delete()` falló por login viejo): al reintentar, la app
      // recibía `permission-denied` y `EliminarCuentaScreen` lo traducía a
      // "tu cuenta está suspendida" — un callejón sin salida y encima falso.
      allow delete: if isAdminRole() ||
        (isSignedIn() && request.auth.uid == uid &&
          (resource == null ||
            resource.data.get('deshabilitado', false) == false));

      // Direcciones favoritas del propio usuario.
      match /favoritos/{favoritoId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Espejo de `usuarios` para clientes (compatibilidad legacy, mismo uid).
    match /cliente/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Historial de ubicaciones buscadas/guardadas por el cliente.
    match /ubicaciones/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // conductores: colección casi sin uso (una sola query en todo el
    // código, para marcadores de taxis disponibles en el mapa del
    // cliente). Sin escrituras conocidas — se deniegan por defecto.
    // ---------------------------------------------------------------
    match /conductores/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Presencia en vivo del conductor conectado (para el mapa "sonar" del
    // cliente). Doc id = uid del conductor, self-managed.
    match /conductores_conectados/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // administradores: escritura solo del propio dueño. Lectura acotada al
    // propio doc o a un admin — antes era cualquier autenticado, porque
    // `AdminFcmService.sendToAllAdmins` (llamado por clientes y conductores)
    // hacía un `.get()` sin filtro sobre toda la colección para juntar
    // `fcmToken` de todos los admins. Ese envío ahora lo hacen triggers de
    // Cloud Functions (`onSoporteChatMensajeUsuarioCreado`,
    // `onSolicitudActivacionConductor`), que corren con el Admin SDK y no
    // están sujetos a estas reglas — auditoría de seguridad: antes cualquier
    // usuario registrado podía leer nombre/teléfono/gremio/fcmToken de todos
    // los administradores. `FcmService._saveCurrentToken` (todo usuario, para
    // ver si tiene doc propio) y `AdminConfiguracionScreen` (siempre lee su
    // propio `adminId`) siguen funcionando porque solo leen su propio uid.
    // ---------------------------------------------------------------
    // ESCALADA DE PRIVILEGIOS CERRADA: antes era
    // `allow write: if isSignedIn() && request.auth.uid == uid`, que permite
    // CREAR el documento propio. Como `isAdminRole()` se limita a comprobar
    // que exista `administradores/{uid}`, cualquier usuario autenticado podía
    // crearse el suyo y quedar como admin: acceso a todos los perfiles de
    // conductor, chats de soporte, reportes y alertas de pánico.
    //
    // Se permite solo ACTUALIZAR un documento que ya existe (lo necesita
    // `FcmService` para persistir el `fcmToken`, y solo escribe si el doc ya
    // existía). La creación queda fuera de la app a propósito: se hace desde
    // la consola o el backend. `UserDataService.guardarAdministrador` no
    // tiene llamadores, así que esto no rompe ningún flujo.
    match /administradores/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminRole());
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------
    // soporte_chats/{userId}: chat de soporte entre un usuario (cliente o
    // conductor) y cualquier admin. Doc id = uid del usuario.
    // ---------------------------------------------------------------
    match /soporte_chats/{userId} {
      allow read, write: if isSignedIn() &&
        (request.auth.uid == userId || isAdminRole());

      match /mensajes/{mensajeId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || isAdminRole());
        allow create: if isSignedIn() &&
          (request.auth.uid == userId || isAdminRole());
        allow update, delete: if false;
      }
    }

    // Reportes (problema con conductor/cliente). Solo el autor los crea con
    // su propio id; solo admins los leen/marcan como atendidos.
    match /reportes/{id} {
      allow read, update: if isAdminRole();
      allow create: if isSignedIn() &&
        (request.resource.data.get('clienteId', '') == request.auth.uid ||
          request.resource.data.get('conductorId', '') == request.auth.uid);
      allow delete: if false;
    }

    // Sugerencias de usuarios. Solo el autor las crea; solo admins las leen
    // y marcan como vistas.
    match /sugerencias/{id} {
      allow read, update: if isAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Alertas de pánico (botón SOS). Solo el autor las crea; solo admins
    // las leen y las marcan como atendidas.
    match /emergencias/{id} {
      allow read, update: if isAdminRole();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
